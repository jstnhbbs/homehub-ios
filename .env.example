# Local development can use file:local.db. Production should use libsql://…
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Generate each secret independently, for example: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Optional: content value from Google Search Console HTML tag verification
GOOGLE_SITE_VERIFICATION=
BLOB_READ_WRITE_TOKEN=

# Email (confirming addresses). Create a Resend account, verify a sending domain, and set both.
# EMAIL_FROM is an address on that domain, for example: Beacon <hello@example.com>
# Without them production sends no email; development prints each email in the server log.
RESEND_API_KEY=
EMAIL_FROM=
